{
  "name": "bitty-buddies",
  "productName": "Bitty Buddies",
  "version": "1.2.7",
  "description": "Blocky pixel pets that live on your desktop.",
  "author": "WiggleCodes",
  "license": "SEE LICENSE IN LICENSE",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/make-icons.js",
    "preview": "node scripts/preview.js",
    "banner": "node scripts/make-banner.js",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "koffi": "^2.16.3"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "com.wigglecodes.bittybuddies",
    "productName": "Bitty Buddies",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/koffi/build/koffi/{darwin,freebsd,linux,musl,openbsd}_*/**",
      "!node_modules/koffi/build/koffi/win32_ia32/**",
      "!node_modules/koffi/src/**",
      "!node_modules/koffi/doc/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Bitty-Buddies",
        "repo": "bitty-buddies",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Bitty-Buddies-Setup-${version}.${ext}"
    },
    "asarUnpack": [
      "node_modules/koffi/**"
    ]
  },
  "bitty": {
    "channel": "test",
    "revokedUrl": "https://raw.githubusercontent.com/Bitty-Buddies/bitty-buddies/main/revoked.json",
    "revokedApi": "https://api.github.com/repos/Bitty-Buddies/bitty-buddies/contents/revoked.json",
    "statsApi": "https://bitty-admin.reece-feetenby.workers.dev/stats",
    "statsNamespace": "bitty-buddies",
    "reportUrl": "https://bitty-admin.reece-feetenby.workers.dev/report",
    "steam": {
      "appId": 0,
      "dlc": [
        {
          "appId": 0,
          "shop": "builds",
          "name": "Builds",
          "packs": [
            "builds"
          ],
          "blurb": "10 builds for your village: a windmill, a wishing well, a fountain, a market stall and more."
        },
        {
          "appId": 0,
          "shop": "fantasy",
          "name": "Fantasy Folk",
          "packs": [
            "fantasy"
          ],
          "blurb": "11 adventurers and 4 homes. The Witch flies on her broom and the Wizard casts real magic."
        },
        {
          "appId": 0,
          "shop": "serverroom",
          "name": "Server Room",
          "packs": [
            "serverroom"
          ],
          "blurb": "An IT team for your desktop. Boot up the server and your engineers fix it when it breaks."
        },
        {
          "appId": 0,
          "shop": "outbreak",
          "name": "Outbreak",
          "packs": [
            "outbreak"
          ],
          "blurb": "42 zombies, soldiers, vehicles and outpost builds. Zombies bite, the army fights back, and only the medic can cure them."
        },
        {
          "appId": 0,
          "shop": "supporter",
          "name": "Supporter Pack",
          "packs": [
            "supporter"
          ],
          "blurb": "A golden hat for every buddy, and a big thank-you."
        }
      ],
      "bundle": {
        "id": 0,
        "name": "Everything Bundle",
        "blurb": "Every pack above in one go, for less."
      }
    }
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.8"
  }
}
